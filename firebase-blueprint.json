{
  "entities": {
    "submission": {
      "title": "Clinic Requirements Submission",
      "description": "Formulário de levantamento de requisitos de automação de WhatsApp para clínica",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "clinicName": {
          "type": "string",
          "maxLength": 200
        },
        "contactName": {
          "type": "string",
          "maxLength": 200
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "answers": {
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "archived"]
        }
      },
      "required": ["clinicName", "whatsapp", "createdAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "submission",
      "description": "Formulários preenchidos pelas clínicas com respostas às 25 perguntas"
    }
  }
}
