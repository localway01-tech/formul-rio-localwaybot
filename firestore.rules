rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['createdAt'])
        && data.createdAt is string && data.createdAt.size() <= 100
        && (!('clinicName' in data) || (data.clinicName is string && data.clinicName.size() <= 200))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 50))
        && (!('contactName' in data) || (data.contactName is string && data.contactName.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('answers' in data) || data.answers is map);
    }

    match /submissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow read, delete: if true;
      allow update: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
